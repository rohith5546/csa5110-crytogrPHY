#include <stdio.h>
#include <stdint.h>

/* Permuted Choice 1 */
int PC1[56] = {
    57, 49, 41, 33, 25, 17, 9,
    1, 58, 50, 42, 34, 26, 18,
    10, 2, 59, 51, 43, 35, 27,
    19, 11, 3, 60, 52, 44, 36,

    63, 55, 47, 39, 31, 23, 15,
    7, 62, 54, 46, 38, 30, 22,
    14, 6, 61, 53, 45, 37, 29,
    21, 13, 5, 28, 20, 12, 4
};

/* Permuted Choice 2 */
int PC2[48] = {
    14, 17, 11, 24, 1, 5,
    3, 28, 15, 6, 21, 10,
    23, 19, 12, 4, 26, 8,
    16, 7, 27, 20, 13, 2,

    41, 52, 31, 37, 47, 55,
    30, 40, 51, 45, 33, 48,
    44, 49, 39, 56, 34, 53,
    46, 42, 50, 36, 29, 32
};

/* DES shift schedule */
int shifts[16] = {
    1, 1, 2, 2,
    2, 2, 2, 2,
    1, 2, 2, 2,
    2, 2, 2, 1
};

uint64_t getBit(uint64_t value, int position, int totalBits)
{
    return (value >> (totalBits - position)) & 1ULL;
}

uint64_t permute(uint64_t input,
                 const int table[],
                 int outputBits,
                 int inputBits)
{
    uint64_t output = 0;
    int i;

    for (i = 0; i < outputBits; i++)
    {
        output <<= 1;
        output |= getBit(input, table[i], inputBits);
    }

    return output;
}

uint32_t leftRotate28(uint32_t value, int shift)
{
    value &= 0x0FFFFFFF;

    return ((value << shift) |
            (value >> (28 - shift))) &
           0x0FFFFFFF;
}

void print48Bits(uint64_t value)
{
    int i;

    for (i = 47; i >= 0; i--)
    {
        printf("%llu",
               (unsigned long long)((value >> i) & 1ULL));

        if (i % 6 == 0)
            printf(" ");
    }
}

int main(void)
{
    uint64_t originalKey;
    uint64_t permutedKey;
    uint64_t encryptionKeys[16];
    uint64_t combined;

    uint32_t C;
    uint32_t D;

    int round;

    printf("Enter a 64-bit DES key in hexadecimal\n");
    printf("Example: 133457799BBCDFF1\n");
    printf("Key: ");

    if (scanf("%llx",
              (unsigned long long *)&originalKey) != 1)
    {
        printf("Invalid key.\n");
        return 1;
    }

    /* Remove parity bits and perform PC-1 */
    permutedKey = permute(originalKey, PC1, 56, 64);

    C = (uint32_t)((permutedKey >> 28) & 0x0FFFFFFF);
    D = (uint32_t)(permutedKey & 0x0FFFFFFF);

    /* Generate encryption keys K1 to K16 */
    for (round = 0; round < 16; round++)
    {
        C = leftRotate28(C, shifts[round]);
        D = leftRotate28(D, shifts[round]);

        combined = ((uint64_t)C << 28) | D;

        encryptionKeys[round] =
            permute(combined, PC2, 48, 56);
    }

    printf("\nEncryption subkey order:\n");

    for (round = 0; round < 16; round++)
    {
        printf("K%-2d = ", round + 1);
        print48Bits(encryptionKeys[round]);
        printf("\n");
    }

    printf("\nDES decryption subkey order:\n");

    for (round = 15; round >= 0; round--)
    {
        printf("Decryption round %2d uses K%-2d = ",
               16 - round,
               round + 1);

        print48Bits(encryptionKeys[round]);
        printf("\n");
    }

    return 0;
}
