#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

// Function to generate Playfair matrix
void generateMatrix(char key[]) {
    int used[26] = {0};
    int i, j, k = 0;

    used['J' - 'A'] = 1; // Treat I and J as same

    for(i = 0; key[i] != '\0'; i++) {
        char ch = toupper(key[i]);
        if(ch == 'J')
            ch = 'I';

        if(ch >= 'A' && ch <= 'Z' && !used[ch - 'A']) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    for(i = 0; i < 26; i++) {
        if(!used[i]) {
            matrix[k / 5][k % 5] = i + 'A';
            k++;
        }
    }
}

// Find position of a character
void findPosition(char ch, int *row, int *col) {
    if(ch == 'J')
        ch = 'I';

    for(int i = 0; i < 5; i++) {
        for(int j = 0; j < 5; j++) {
            if(matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

// Playfair decryption
void decrypt(char text[]) {
    int len = strlen(text);

    printf("\nPlain Text:\n");

    for(int i = 0; i < len; i += 2) {

        if(text[i] == ' ') {
            printf(" ");
            i--;
            continue;
        }

        char a = text[i];
        char b = text[i + 1];

        int r1, c1, r2, c2;

        findPosition(a, &r1, &c1);
        findPosition(b, &r2, &c2);

        if(r1 == r2) {
            printf("%c%c",
                   matrix[r1][(c1 + 4) % 5],
                   matrix[r2][(c2 + 4) % 5]);
        }
        else if(c1 == c2) {
            printf("%c%c",
                   matrix[(r1 + 4) % 5][c1],
                   matrix[(r2 + 4) % 5][c2]);
        }
        else {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }
}

int main() {

    char key[100];

    char cipher[] =
    "KXJEYUREBEZWEHEWRYTUHEYFS"
    "KREHEGOYFIWTTTUOLKSYCAJPO"
    "BOTEIZONTXBYBNTGONEYCUZWR"
    "GDSONSXBOUYWRHEBAAHYUSEDQ";

    printf("Enter Playfair Key: ");
    scanf("%s", key);

    generateMatrix(key);

    printf("\nPlayfair Matrix:\n");
    for(int i = 0; i < 5; i++) {
        for(int j = 0; j < 5; j++) {
            printf("%c ", matrix[i][j]);
        }
        printf("\n");
    }

    decrypt(cipher);

    return 0;
}
