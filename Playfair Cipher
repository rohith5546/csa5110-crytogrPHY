#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void generateMatrix(char key[])
{
    int used[26] = {0};
    int i, j = 0, k = 0;

    used['J' - 'A'] = 1; // J is treated as I

    for(i = 0; key[i] != '\0'; i++)
    {
        char ch = toupper(key[i]);

        if(ch == 'J')
            ch = 'I';

        if(ch >= 'A' && ch <= 'Z' && !used[ch - 'A'])
        {
            matrix[j][k++] = ch;
            used[ch - 'A'] = 1;

            if(k == 5)
            {
                j++;
                k = 0;
            }
        }
    }

    for(i = 0; i < 26; i++)
    {
        if(!used[i])
        {
            matrix[j][k++] = i + 'A';

            if(k == 5)
            {
                j++;
                k = 0;
            }
        }
    }
}

void findPosition(char ch, int *row, int *col)
{
    int i, j;

    if(ch == 'J')
        ch = 'I';

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
        {
            if(matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main()
{
    char key[50], text[100];
    char plain[100];
    int i, len = 0;

    printf("Enter Keyword: ");
    scanf("%s", key);

    generateMatrix(key);

    printf("\nPlayfair Matrix:\n");
    for(i = 0; i < 5; i++)
    {
        int j;
        for(j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    printf("\nEnter Plain Text: ");
    scanf("%s", text);

    for(i = 0; text[i] != '\0'; i++)
    {
        char ch = toupper(text[i]);

        if(ch == 'J')
            ch = 'I';

        if(ch >= 'A' && ch <= 'Z')
            plain[len++] = ch;
    }

    plain[len] = '\0';

    if(len % 2 != 0)
    {
        plain[len++] = 'X';
        plain[len] = '\0';
    }

    printf("\nCipher Text: ");

    for(i = 0; i < len; i += 2)
    {
        int r1, c1, r2, c2;

        findPosition(plain[i], &r1, &c1);
        findPosition(plain[i + 1], &r2, &c2);

        if(r1 == r2)
        {
            printf("%c%c",
                   matrix[r1][(c1 + 1) % 5],
                   matrix[r2][(c2 + 1) % 5]);
        }
        else if(c1 == c2)
        {
            printf("%c%c",
                   matrix[(r1 + 1) % 5][c1],
                   matrix[(r2 + 1) % 5][c2]);
        }
        else
        {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    return 0;
}


